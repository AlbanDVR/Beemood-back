# Utilise une image Python officielle avec une version spécifique
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# Configure le proxy de l'université pour pip (nécessaire pour Kaniko)
ENV http_proxy=http://proxy.univ-lyon1.fr:3128
ENV https_proxy=http://proxy.univ-lyon1.fr:3128
ENV HTTP_PROXY=http://proxy.univ-lyon1.fr:3128
ENV HTTPS_PROXY=http://proxy.univ-lyon1.fr:3128

# Installe les dépendances système nécessaires (ex: pour PostgreSQL)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Crée le répertoire de travail
WORKDIR /app

# Copie uniquement requirements.txt pour tirer parti du cache Docker
COPY requirements.txt .

# Installe les dépendances Python avec pip (via le proxy)
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copie le reste du code
COPY . .

# Variable d'environnement pour le port
ENV PORT=8000
EXPOSE $PORT

# Commande pour démarrer l'application en production
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
